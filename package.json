{
  "name": "ai-command-center",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-Grade Autonomous AI Command Center",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run --workspace=@ai-command-center/shared build && npm run --workspace=@ai-command-center/config build && npm run --workspace=@ai-command-center/security build && npm run --workspace=@ai-command-center/database build && npm run --workspace=@ai-command-center/integrations build && npm run --workspace=@ai-command-center/ai-engine build && npm run --workspace=@ai-command-center/automation build",
    "build:apps": "npm run --workspace=@ai-command-center/api build && npm run --workspace=@ai-command-center/worker build && npm run --workspace=@ai-command-center/web build",
    "check-types": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prisma:generate": "npm run generate --workspace=@ai-command-center/database",
    "prisma:validate": "npm run validate --workspace=@ai-command-center/database"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "keywords": [
    "autonomous-agents",
    "command-center",
    "enterprise-ai",
    "zero-cost"
  ],
  "author": "Enterprise Architecture Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/rate-limit": "^11.2.2",
    "@next/env": "15.1.12",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongodb": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "argon2": "^0.45.2",
    "autoprefixer": "^10.4.20",
    "bullmq": "^6.7.0",
    "caniuse-lite": "^1.0.30001822",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.69.0",
    "mongodb": "^7.8.0",
    "next": "^15.1.12",
    "playwright": "^1.64.1",
    "postcss": "^8.5.1",
    "postcss-selector-parser": "^7.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17"
  }
}