{
  "name": "ai-command-center",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-Grade Autonomous AI Command Center",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "check-types": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prisma:generate": "npm run generate --workspace=@ai-command-center/database",
    "prisma:validate": "npm run validate --workspace=@ai-command-center/database"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "keywords": [
    "autonomous-agents",
    "command-center",
    "enterprise-ai",
    "zero-cost"
  ],
  "author": "Enterprise Architecture Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/rate-limit": "^11.2.2",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongodb": "^4.0.6",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.0",
    "cookie": "^2.0.1",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.8.0",
    "playwright": "^1.64.1"
  }
}
