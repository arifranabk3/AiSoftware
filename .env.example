# ==========================================
# AI COMMAND CENTER — ENVIRONMENT TEMPLATE
# ==========================================
# NON-NEGOTIABLE ZERO-COST POLICY:
# Never put paid keys or billing credentials here.
# ==========================================

NODE_ENV=development
PORT=3001
WEB_PORT=3000

# Database & Cache (PostgreSQL & Redis)
# Local Docker or Zero-Cost Neon / Upstash instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_command_center?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Security Tokens (Minimum 32 characters random strings)
JWT_SECRET=replace_with_a_secure_random_32_char_secret_key_1
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_32_char_secret_key_2
MASTER_ENCRYPTION_KEY=replace_with_a_secure_random_32_char_secret_key_3

# Owner Notification Details (Phone number with country code for WhatsApp alerts)
OWNER_PHONE_NUMBER=+1234567890
OWNER_EMAIL=owner@example.com

# Free-Tier AI Providers (Obtained via Free Tiers)
GEMINI_API_KEY=your_free_google_ai_studio_api_key
GROQ_API_KEY=your_free_groq_api_key
HUGGING_FACE_TOKEN=your_free_hf_user_token

# Governance & Safety
SYSTEM_EMERGENCY_HALT=false
ZERO_COST_STRICT_MODE=true

